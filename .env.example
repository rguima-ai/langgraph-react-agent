# Copiá este archivo como .env y reemplazá solamente el valor de la API key.
OPENAI_API_KEY=replace_with_your_openai_api_key

# Podés cambiar el modelo sin tocar el código.
OPENAI_MODEL=gpt-4.1-mini

# La base SQLite y la traza se crean automáticamente al ejecutar el programa.
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
TRACE_OUTPUT_PATH=traces/latest_trace.json
THREAD_ID=cliente-102-demo
